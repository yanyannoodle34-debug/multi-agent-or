# Copy to .env and fill in the keys for the provider you use in config.yaml.
# Loaded automatically at startup (see orchestrator.load_dotenv). Existing shell
# environment variables always win, so exports still override this file.
# .env is gitignored — never commit real keys.

# Default provider (config.yaml -> provider: openrouter). Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# provider: nvidia — free key at https://build.nvidia.com
# NVIDIA_API_KEY=nvapi-...

# provider: deepseek — https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=sk-...

# provider: anthropic
# ANTHROPIC_API_KEY=...

# Telegram control bot (telegram_bot.py) — token from @BotFather
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Comma-separated Telegram user IDs allowed to control the bot (empty = OPEN mode)
# TELEGRAM_ADMIN_IDS=123456789,987654321
